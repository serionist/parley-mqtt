{
  // The default program used by the editor, typescript-eslint's projectService, and the test-side
  // typecheck. It covers src + test with the Node + DOM ambient types the vitest suites rely on
  // (node:fs / node:url / AbortController). The stricter src-only floor lives in tsconfig.src.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "test"]
}
