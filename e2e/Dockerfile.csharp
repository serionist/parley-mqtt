# Parley interop test peer — C# / .NET 10, MQTTnet 5.2.0.1603. Build context: repo root.
# Base images digest-pinned (tags kept for readability) for reproducible builds — resolved 2026-07.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:ed034a8bf0b24ded0cbbac07e17825d8e9ebfe21e308191d0f7421eaf5ad4664 AS build
WORKDIR /src
COPY csharp/ ./csharp/
RUN dotnet publish csharp/src/Parley.TestPeer/Parley.TestPeer.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/runtime:10.0@sha256:ed5d539b27842d656a06a5984dbcb5114d3e885fbada612a49a5a7c3c3a44e1c
WORKDIR /app
COPY --from=build /app ./
COPY docs/conformance/interop/scenarios.json /app/scenarios.json
COPY docs/conformance/interop/deep-scenarios.json /app/deep-scenarios.json
ENTRYPOINT ["dotnet", "/app/Parley.TestPeer.dll"]
