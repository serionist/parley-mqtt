{
  "name": "busy-received-in-live-ignored",
  "role": "commander",
  "rules": ["C4"],
  "config": {},
  "steps": [
    { "at": 0, "call": { "id": "A", "p": { "x": 1 } } },
    { "at": 0, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 500, "in": { "topic": "heartbeat", "msg": { "v": 1, "t": "hb", "id": "A" } } },
    { "at": 500, "expect": [] },
    { "at": 1000, "in": { "topic": "result", "msg": { "v": 1, "t": "res", "id": "A", "ok": false, "e": "$busy" } } },
    { "at": 1000, "expect": [] },
    { "at": 1500, "in": { "topic": "result", "msg": { "v": 1, "t": "res", "id": "A", "ok": true, "p": { "r": 1 } } } },
    { "at": 1500, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "rak", "id": "A" } } ] }
  ],
  "outcomes": { "A": { "ok": true, "p": { "r": 1 } } }
}
