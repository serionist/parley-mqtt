{
  "name": "reconnect-commander-resubscribe-timers-unaffected",
  "role": "commander",
  "rules": ["§2"],
  "config": {},
  "steps": [
    { "at": 0, "call": { "id": "A", "p": { "x": 1 } } },
    { "at": 0, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 1000, "connected": true },
    { "at": 1000, "expect": [ { "subscribe": "heartbeat" }, { "subscribe": "progress" }, { "subscribe": "result" } ] },
    { "at": 2000, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 2500, "in": { "topic": "heartbeat", "msg": { "v": 1, "t": "hb", "id": "A" } } },
    { "at": 2500, "expect": [] },
    { "at": 3000, "in": { "topic": "result", "msg": { "v": 1, "t": "res", "id": "A", "ok": true, "p": { "r": 1 } } } },
    { "at": 3000, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "rak", "id": "A" } } ] }
  ],
  "outcomes": { "A": { "ok": true, "p": { "r": 1 } } }
}
