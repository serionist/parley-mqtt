{
  "name": "res-as-first-sign-of-life",
  "role": "commander",
  "rules": ["C2", "C4"],
  "config": {},
  "steps": [
    { "at": 0, "call": { "id": "A", "p": { "x": 1 } } },
    { "at": 0, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 500, "in": { "topic": "result", "msg": { "v": 1, "t": "res", "id": "A", "ok": true, "p": { "r": 1 } } } },
    { "at": 500, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "rak", "id": "A" } } ] },
    { "at": 2000, "expect": [] }
  ],
  "outcomes": { "A": { "ok": true, "p": { "r": 1 } } }
}
