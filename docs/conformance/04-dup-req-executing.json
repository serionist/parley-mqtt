{
  "name": "duplicate-req-while-executing",
  "role": "handler",
  "rules": ["H1"],
  "config": {},
  "steps": [
    { "at": 0, "in": { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } },
    { "at": 0, "expect": [ { "topic": "heartbeat", "msg": { "v": 1, "t": "hb", "id": "A" } } ] },
    { "at": 1000, "in": { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } },
    { "at": 1000, "expect": [ { "topic": "heartbeat", "msg": { "v": 1, "t": "hb", "id": "A" } } ] },
    { "at": 2000, "handler": { "id": "A", "action": "complete", "p": { "r": 1 } } },
    { "at": 2000, "expect": [ { "topic": "result", "msg": { "v": 1, "t": "res", "id": "A", "ok": true, "p": { "r": 1 } } } ] },
    { "at": 2100, "in": { "topic": "request", "msg": { "v": 1, "t": "rak", "id": "A" } } },
    { "at": 2100, "expect": [] }
  ]
}
