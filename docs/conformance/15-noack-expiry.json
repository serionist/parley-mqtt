{
  "name": "noack-expiry",
  "role": "commander",
  "rules": ["C1", "C3"],
  "config": { "requestRetryInterval": 2000, "noAckTimeout": 7000 },
  "steps": [
    { "at": 0, "call": { "id": "A", "p": { "x": 1 } } },
    { "at": 0, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 2000, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 4000, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 6000, "expect": [ { "topic": "request", "msg": { "v": 1, "t": "req", "id": "A", "p": { "x": 1 } } } ] },
    { "at": 7000, "expect": [] }
  ],
  "outcomes": { "A": { "ok": false, "e": "$noAck" } }
}
