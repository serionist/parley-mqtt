# ---- Secrets / local Claude Code state (MCP tokens) — NEVER commit ----
.claude/settings.local.json
.env
.env.*
!.env.example

# ---- .NET ----
bin/
obj/
artifacts/
*.nupkg

# ---- Node / TS ----
node_modules/
dist/
*.tsbuildinfo

# ---- PlatformIO / C++ ----
.pio/

# ---- Editors / OS ----
.vs/
.idea/
.DS_Store
*.swp

# ---- Local, never-published notes ----
_private/

# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# C++ native builds
cpp/build*/

# ---- e2e generated interop reports (regenerated every run; keep the directory) ----
e2e/reports/*
!e2e/reports/.gitkeep
