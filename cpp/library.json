{
  "name": "ParleyMqtt",
  "version": "1.0.0",
  "description": "Request/response RPC over MQTT for ESP32/Arduino — statically allocated, no-exceptions, tick-driven. Commander + handler protocol core over a consumer-supplied MQTT transport adapter and an ArduinoJson codec.",
  "keywords": "mqtt, rpc, esp32, arduino, request-response, parley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/serionist/parley-mqtt.git"
  },
  "authors": [
    {
      "name": "The Parley Authors",
      "url": "https://github.com/serionist/parley-mqtt",
      "maintainer": true
    }
  ],
  "frameworks": "arduino",
  "platforms": "*",
  "headers": "Parley.h",
  "examples": [
    "examples/*/*.ino"
  ],
  "dependencies": [
    {
      "name": "ArduinoJson",
      "version": "7.4.3"
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "library.json",
      "library.properties",
      "README.md",
      "LICENSE"
    ]
  },
  "build": {
    "srcDir": "src",
    "flags": [
      "-DARDUINOJSON_USE_DOUBLE=1"
    ]
  }
}
