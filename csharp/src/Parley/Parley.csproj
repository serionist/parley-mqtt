<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>Parley</RootNamespace>
    <AssemblyName>Parley</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <Description>Request/response RPC over MQTT (MQTT RPC / request-reply): call a typed command on another service or device over the MQTT broker you already share, stream progress, cancel it, and get one typed result back. Distinguishes "nobody answered" from "it accepted then went silent" from "it ran too long" via per-execution heartbeats, and gives at-most-once execution even at QoS 0 through retry, result-acknowledgement and two-sided deduplication. Transport-free: no MQTT-client dependency, no code generation — you supply a live connection through a small adapter. C# reference implementation of the Parley v1 wire protocol, which is also implemented in TypeScript/JS, Python and C++ (ESP32/Arduino).</Description>
  </PropertyGroup>

  <!--
    NuGet package metadata. Distribution id is `Parley.Mqtt` (the bare `Parley` id is taken);
    the assembly / namespace stay `Parley`. Version is inherited from csharp/Directory.Build.props
    (lockstep across all four ecosystems). License is the SPDX expression; the packaged README is
    csharp/README.md (registry-rendered, absolute links). SourceLink + a snupkg symbol package +
    a deterministic CI build make the sources navigable from the debugger.
  -->
  <PropertyGroup>
    <PackageId>Parley.Mqtt</PackageId>
    <Authors>The Parley Authors</Authors>
    <Company>The Parley Authors</Company>
    <Product>Parley</Product>
    <Copyright>Copyright (c) 2026 The Parley Authors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/serionist/parley-mqtt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/serionist/parley-mqtt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mqtt;rpc;mqtt-rpc;request-response;request-reply;remote-procedure-call;iot;protocol;messaging;esp32;dotnet;aot</PackageTags>
    <PackageReleaseNotes>https://github.com/serionist/parley-mqtt/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- SourceLink / deterministic-build knobs. ContinuousIntegrationBuild is set true only in CI. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaged README (packs to the nupkg root as README.md; not compiled/shipped in the assembly). -->
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Text.Json (source generators) — in-box on net10.0, packaged for netstandard2.0. -->
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- TimeProvider polyfill — in-box on net10.0. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- SourceLink: build/pack-time only, nothing added to the consumer's dependency graph. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parley.Tests" />
  </ItemGroup>

</Project>
